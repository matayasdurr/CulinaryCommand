@page "/prep-list"
@using CulinaryCommand.Models
@using CulinaryCommand.Services
@inject IPrepService PrepSvc
@inject IJSRuntime Js


<NewPrepItemModal 
    Visible="@showModal"
    Item="@editingItem"
    OnCancel="CloseModal"
    OnSave="HandleSave" />

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-semibold text-gray-800">Prep List</h2>
        <div class="flex space-x-2">
            <input type="date" @bind="selectedDate" class="border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <button class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 focus:outline-none" @onclick="() => OpenNewModal()">
                <i class="fas fa-plus mr-2"></i> New Item
            </button>
        </div>
    </div>

    <div class="overflow-x-auto bg-white rounded-lg shadow">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Par</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Count</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prep</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned To</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                 </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in prepItems)
                {
                    <tr class="prep-item hover:bg-gray-50 transition-all">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@item.Name</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Par</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Count</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@item.Prep</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.AssignedTo</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(GetStatusClasses(item.Status))">@item.Status</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                            <button type="button"
                                    class="text-indigo-600 hover:text-indigo-900"
                                    @onclick="() => BeginEdit(item)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button type="button"
                                    class="text-red-600 hover:text-red-900"
                                     @onclick="() => DeleteItem(item.Id, item.Name)">
                                <i class="fas fa-trash"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private DateTime selectedDate = DateTime.Today;
    private List<PrepItem> prepItems = new();
    private bool showModal;
    private PrepItem editingItem = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        prepItems = await PrepSvc.GetAllAsync(selectedDate);
    }

    private void OpenNewModal()
    {
        editingItem = new PrepItem();
        showModal = true;
    }

    private void BeginEdit(PrepItem item)
    {
        editingItem = new PrepItem
        {
            Id = item.Id,
            Name = item.Name,
            Category = item.Category,
            Par = item.Par,
            Count = item.Count,
            Prep = item.Prep,
            AssignedTo = item.AssignedTo,
            Status = item.Status
        };
        showModal = true;
    }

    private async Task DeleteItem(int id, string name)
    {
    // Show a JS confirm dialog
    var ok = await Js.InvokeAsync<bool>("confirm", $"Are you sure you want to delete “{name}”?");
    if (!ok)
        return;

    await PrepSvc.DeleteAsync(id);
    await LoadItems();
    }

    private void CloseModal()
    {
        showModal = false;
        editingItem = new PrepItem();
    }

    private async Task HandleSave(PrepItem item)
    {
        if (item.Id == 0)
            await PrepSvc.AddAsync(item);
        else
            await PrepSvc.UpdateAsync(item);

        await LoadItems();
        CloseModal();
    }

    private string GetStatusClasses(PrepStatus status) => status switch
    {
        PrepStatus.InProgress => "bg-green-100 text-green-800",
        PrepStatus.Complete => "bg-blue-100 text-blue-800",
        PrepStatus.NeedsOrder => "bg-red-100 text-red-800",
        _ => "bg-yellow-100 text-yellow-800",
    };
}
