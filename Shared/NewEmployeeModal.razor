@using CulinaryCommand.Models
<EditForm Model="Item" OnValidSubmit="HandleValidSubmit">
  <DataAnnotationsValidator />
  <ValidationSummary />

  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 @(Visible ? "" : "hidden")">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md fade-in p-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold">Add/Edit Employee</h3>
        <button type="button" @onclick="Cancel" class="text-gray-500 hover:text-gray-700">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="mb-4">
        <label class="block mb-1">Name</label>
        <InputText @bind-Value="Item.Name" class="w-full border rounded px-3 py-2" />
      </div>

      <div class="mb-4">
        <label class="block mb-1">Role</label>
        <InputText @bind-Value="Item.Role" class="w-full border rounded px-3 py-2" />
      </div>

      <div class="mb-4">
        <label class="block mb-1">Email</label>
        <InputText @bind-Value="Item.Email" type="email" class="w-full border rounded px-3 py-2" />
      </div>

      <div class="mb-6 flex items-center">
        <InputCheckbox @bind-Value="Item.IsActive" class="mr-2" />
        <label>Active</label>
      </div>

      <div class="flex justify-end space-x-3">
        <button type="button" class="px-4 py-2 border rounded" @onclick="Cancel">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded">Save</button>
      </div>
    </div>
  </div>
</EditForm>

@code {
  [Parameter] public bool Visible { get; set; }
  [Parameter] public Employee Item { get; set; } = new();
  [Parameter] public EventCallback OnCancel { get; set; }
  [Parameter] public EventCallback<Employee> OnSave { get; set; }

  private async Task HandleValidSubmit() => await OnSave.InvokeAsync(Item);
  private async Task Cancel() => await OnCancel.InvokeAsync();
}
